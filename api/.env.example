# --- Database ---------------------------------------------------------------
# WARNING: keep this file pointed at a LOCAL database. Alembic reads .env, and
# environment variables override it -- so a .env holding production credentials
# means `alembic downgrade` silently drops tables in production.
# Two URLs to the same database, differing only in driver. This is deliberate.
#
# The app is async and needs asyncpg. Omit the `+asyncpg` marker and SQLAlchemy
# falls back to psycopg2, which is not installed, and fails on import.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pokemon
#
# Alembic runs synchronously and uses psycopg. Configuring async Alembic instead
# buys nothing and costs a greenlet bridge in every migration.
#
# OPTIONAL. When unset it is derived from DATABASE_URL by swapping in the
# psycopg driver, so a platform that configures only DATABASE_URL still
# migrates correctly on container start. Set it explicitly to point migrations
# at a different database than the app.
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pokemon
#
# Against a managed provider (Neon, Railway) the same pair looks like:
#   DATABASE_URL=postgresql+asyncpg://user:pw@host/db
#   ALEMBIC_DATABASE_URL=postgresql+psycopg://user:pw@host/db?sslmode=require
#
# Note the asymmetry in `sslmode`. psycopg is libpq-based and reads it natively.
# asyncpg does not understand it and raises TypeError on the unexpected kwarg,
# so it is stripped from DATABASE_URL and re-applied as connect_args={"ssl": ...}.
# Leaving `?sslmode=require` on DATABASE_URL is safe -- it is stripped for you --
# but the TLS it requests is what actually reaches the connection.

# --- CORS -------------------------------------------------------------------
# Comma-separated allowed origins. `*` is legal because allow_credentials=False:
# no cookies or Authorization headers cross this boundary.
CORS_ORIGINS=*

# --- Ingest -----------------------------------------------------------------
# 'fixture' reads fixtures/pokeapi-snapshot.json; 'live' hits pokeapi.co.
# Fixture is the default on purpose -- a live seed is thousands of requests.
POKEAPI_SOURCE=fixture
POKEAPI_CONCURRENCY=5
POKEAPI_BATCH_DELAY=0.5

# --- Admin ------------------------------------------------------------------
# HTTP Basic for the /admin routes only. Presentation hygiene, not a security
# boundary: the data is public and there is no user auth. Defaults are
# published so a reviewer can log in. /docs and /openapi.json stay open.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pokemon

# Alternative credential for scheduled callers (GitHub Actions), which cannot
# answer a browser password prompt. Leave empty to disable it entirely.
CRON_SECRET=
