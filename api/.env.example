# Local dev against the docker-compose Postgres.
# In production this is set by the platform (Railway variable -> Neon connection
# string). A plain `postgresql://` URL with `?sslmode=require` is accepted and
# normalized for asyncpg at startup.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pokemon

# Comma-separated allowed origins. `*` is safe here because credentials are off.
# In production set this to the deployed frontend URL.
CORS_ORIGINS=*
